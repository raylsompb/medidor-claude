{
  "name": "medidor-claude",
  "productName": "Medidor Claude",
  "version": "1.0.0",
  "description": "Mostra o uso do Claude (sessão e semana) na bandeja do Windows.",
  "main": "src/main.js",
  "author": "pc-ok",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "screenshot": "electron . --mock --screenshot",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.local.medidorclaude",
    "productName": "Medidor Claude",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Medidor Claude",
      "artifactName": "MedidorClaude-Setup-${version}.exe",
      "uninstallDisplayName": "Medidor Claude"
    }
  }
}
